#Auto generated by Edalize

meta:
  flow: {{flow}}
  {% if remove_steps %}
  substituting_steps:
  {% for step in remove_steps %}
    {{step}}: null
  {% endfor %}
  {% endif %}

# Design and clock
DESIGN_NAME: {{design_name}}
CLOCK_PORT: {{clock_port}}
{% if clock_net != None%}
CLOCK_NET: {{clock_net}}
{% endif %}
CLOCK_PERIOD: {{clock_period}}

{% if disable_variables %}
# Disabled variables
{% for variable in disable_variables %}
{{variable}}: False
{% endfor %}
{% endif %}

{% if enable_variables %}
# Enabled variables
{% for variable in enable_variables %}
{{variable}}: True
{% endfor %}
{% endif %}

{% if additional_variables %}
# Additional variables
{% for variable in additional_variables %}
{{variable}}
{% endfor %}
{% endif %}

{% if tcl_pdn %}
# PDN config file
PDN_CFG: dir::{{tcl_pdn}}
{% endif %}

{% if macro_placement %}
# Macro placement file
MACRO_PLACEMENT_CFG: dir::{{macro_placement}}
{% endif %}

{% if pin_order %}
# Pin order
IO_PIN_ORDER_CFG: dir::{{pin_order}}
{% endif %}

# Verilog files
VERILOG_FILES:
{% for verilog_file in verilog_files %}
- dir::{{verilog_file}}
{% endfor %}

{% if verilog_include_dirs %}
VERILOG_INCLUDE_DIRS:
{% for include_file in verilog_include_dirs %}
- dir::{{include_file}}
{% endfor %}
{% endif %}

{% if verilog_defines %}
VERILOG_DEFINES:
{% for define_name, define_value in verilog_defines.items() %}
{% if define_value is not boolean %}
- {{define_name}}={{define_value}}
{% else %}
- {{define_name}}={{1 if define_value else 0}}
{% endif %}
{% endfor %}
{% endif %}

# Verilator config files
{% if vlt_files %}
LINTER_VLT:
{% for vlt_file in vlt_files %}
- dir::{{vlt_file}}
{% endfor %}
{% endif %}

# Size
FP_SIZING: absolute
{% if die_area %}
DIE_AREA: [{{die_area | join(', ')}}]
{% endif %}
CORE_AREA: [{{core_area | join(', ')}}]

{% if pad_north or pad_south or pad_west or pad_east %}
# Pads
{% if pad_north %}
PAD_NORTH: [
    {% for pad in pad_north %}
    "{{ pad }}"{% if not loop.last %},{% endif %} 
    {% endfor %}
]
{% endif %}

{% if pad_south %}
PAD_SOUTH: [
    {% for pad in pad_south %}
    "{{ pad }}"{% if not loop.last %},{% endif %} 
    {% endfor %}
]
{% endif %}

{% if pad_west %}
PAD_WEST: [
    {% for pad in pad_west %}
    "{{ pad }}"{% if not loop.last %},{% endif %} 
    {% endfor %}
]
{% endif %}

{% if pad_east %}
PAD_EAST: [
    {% for pad in pad_east %}
    "{{ pad }}"{% if not loop.last %},{% endif %} 
    {% endfor %}
]
{% endif %}

{% endif %}
